# Ciclo lectivo (edad al 30 de junio de este año)
NEXT_PUBLIC_CICLO_LECTIVO=2026

# google = Google Sheets API | local = JSON en /data (desarrollo)
SHEETS_PROVIDER=google

# ID de la hoja: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Inscripciones

# Service Account de Google Cloud (JSON key → client_email y private_key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPEGAR_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"

# Cooperadora (Mercado Pago). Sin token, el aporte se confirma en modo local.
NEXT_PUBLIC_COOPERADORA_MONTO=3000
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Links de redes (footer). Dejalos vacíos hasta tener las URLs.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/cefcaseros/
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/profile.php?id=61552714892544
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_WHATSAPP=