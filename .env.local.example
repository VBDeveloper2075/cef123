# Ciclo lectivo (edad al 30 de junio de este año)
NEXT_PUBLIC_CICLO_LECTIVO=2026

# google = Google Sheets API | local = JSON en /data (desarrollo)
SHEETS_PROVIDER=google

# ID de la hoja: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Inscripciones

# Service Account de Google Cloud (JSON key → client_email y private_key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPEGAR_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"
